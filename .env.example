# Copy to .env (make up does it for you) and change the passwords.
# Never commit .env.

# TimescaleDB
POSTGRES_USER=llobregat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logistics
# Host port for TimescaleDB. Not 5432, so it never collides with a local Postgres.
POSTGRES_HOST_PORT=15432
# Password of the read-only grafana_reader role
GRAFANA_DB_PASSWORD=change-me-reader

# S3-compatible object storage (RustFS)
S3_ACCESS_KEY=llobregat
S3_SECRET_KEY=change-me-too

# Grafana admin (viewers need no login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-as-well

# OpenStreetMap extract for the OSRM road graph (258 MB, built once)
OSRM_PBF_URL=https://download.geofabrik.de/europe/spain/cataluna-latest.osm.pbf

# Optional external API keys. Everything works without them.
AEMET_API_KEY=
