{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RogerTito455/datacycle-logistics-route-optimization/services/generator/seed/fleet.schema.json",
  "title": "Llobregat Express fleet register",
  "description": "Structure of the AI-generated fleet register (prompt 002): one record per delivery vehicle. Plate letters, type counts, home zones and the afternoon wave are checked against company.json by validate_seeds.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_for",
    "vehicles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_for": {
      "const": "Llobregat Express fleet register"
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicle_id",
          "type_id",
          "plate",
          "registration_year",
          "odometer_km",
          "battery_state_of_health_pct",
          "home_zone_id",
          "runs_afternoon_wave",
          "telematics_unit_id",
          "maintenance_note"
        ],
        "properties": {
          "vehicle_id": {
            "type": "string",
            "pattern": "^V-\\d{2}$"
          },
          "type_id": {
            "enum": [
              "EV-L",
              "EV-M",
              "EV-S",
              "EV-Q",
              "CNG-L",
              "DSL-L"
            ]
          },
          "plate": {
            "type": "string",
            "pattern": "^\\d{4} [A-Z]{3}$"
          },
          "registration_year": {
            "type": "integer",
            "minimum": 2016,
            "maximum": 2026
          },
          "odometer_km": {
            "type": "integer",
            "minimum": 0
          },
          "battery_state_of_health_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "home_zone_id": {
            "type": "string",
            "pattern": "^Z\\d{2}$"
          },
          "runs_afternoon_wave": {
            "type": "boolean"
          },
          "telematics_unit_id": {
            "type": "string",
            "pattern": "^TLM-[0-9A-F]{6}$"
          },
          "maintenance_note": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
