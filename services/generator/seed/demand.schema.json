        },
        "07": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "08": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "09": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "10": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "11": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "12": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "13": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "14": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "15": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "16": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "17": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "18": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "19": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "20": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "21": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "22": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "23": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "weekday_multipliers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat"
      ],
      "properties": {
        "Mon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Tue": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Wed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Thu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Fri": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Sat": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "consumer_window_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morning_wave",
        "afternoon_evening_wave",
        "specific_slot_share"
      ],
      "properties": {
        "morning_wave": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "afternoon_evening_wave": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "specific_slot_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "failed_first_attempt_probability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "business",
        "evening_window_factor"
      ],
      "properties": {
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium",
            "high"
          ],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "business": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium",
            "high"
          ],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "evening_window_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "parcels_per_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "business"
      ],
      "properties": {
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "3",
            "4+"
          ],
          "properties": {
            "1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "3": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "4+": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "business": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "3",
            "4+"
          ],
          "properties": {
            "1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "3": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "4+": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "business_opening_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shops",
        "offices",
        "industry",
        "healthcare"
      ],
      "properties": {
        "shops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "lunch_break"
          ],
          "properties": {
            "open": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "close": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "lunch_break": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "offices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "lunch_break"
          ],
          "properties": {
            "open": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "close": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "lunch_break": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "industry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "lunch_break"
          ],
          "properties": {
            "open": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "close": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "lunch_break": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "healthcare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "lunch_break"
          ],
          "properties": {
            "open": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "close": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "lunch_break": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
