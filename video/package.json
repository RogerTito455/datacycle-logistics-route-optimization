{
  "name": "llobregat-express-video",
  "description": "Llobregat Express explainer video: Remotion composition, ElevenLabs narration and music",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LlobregatExpress out/llobregat-express.mp4 --codec=h264 --crf=18 --audio-bitrate=256k",
    "voice": "node scripts/audio.ts lines",
    "sfx": "node scripts/audio.ts sfx",
    "music": "node scripts/audio.ts music",
    "audio:check": "node scripts/audio.ts check",
    "map": "node scripts/map.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
