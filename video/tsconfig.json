{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "types": ["node"],
    "lib": ["dom", "es2022"],
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "remotion.config.ts"]
}
